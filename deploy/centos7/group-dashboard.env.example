# Copy to /etc/group-dashboard/group-dashboard.env and adjust values.
# Default deployment uses the H2 database file copied from backend/data/.
# Do not set SPRING_PROFILES_ACTIVE=mysql unless you have already migrated data to MySQL.
SERVER_PORT=8080

# Runtime data must be read from the backend database.
# Excel is only used by the admin import page to write data into the database.
DASHBOARD_EXCEL_PATH=/data/group-dashboard/excel/import-source.xlsx
DASHBOARD_PHOTO_DIR=/data/group-dashboard/photos
